PORT=9101
COLLABORATION_ENABLED=true
COLLABORATION_ADDRESS=0.0.0.0
COLLABORATION_PORT=9102
COLLABORATION_STORE_DEBOUNCE_MS=1500
COLLABORATION_STORE_MAX_DEBOUNCE_MS=10000
COLLABORATION_MAX_PAYLOAD_BYTES=5242880
READER_AI_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

LOGHOME_DB_HOST=127.0.0.1
LOGHOME_DB_PORT=3306
LOGHOME_DB_USER=loghome
LOGHOME_DB_PASSWORD=change-me
LOGHOME_DB_NAME=loghome

# 智能纠错独立 LLM API（默认 https://llm.codesocean.top，模型 deepseek-reasoner-fast）
WRITER_TEXT_CORRECTION_API_KEY=fill-your-key-here
# WRITER_TEXT_CORRECTION_API_BASE_URL=https://llm.codesocean.top
# WRITER_TEXT_CORRECTION_MODEL=deepseek-reasoner-fast
# 每批独立超时；整章分批处理，成功段落不会因其他批次失败而丢失
WRITER_TEXT_CORRECTION_REQUEST_TIMEOUT_MS=120000
WRITER_TEXT_CORRECTION_BATCH_CHARS=2800
WRITER_TEXT_CORRECTION_BATCH_PARAGRAPHS=12
WRITER_TEXT_CORRECTION_CONCURRENCY=2
WRITER_TEXT_CORRECTION_MAX_TOKENS=4096
WRITER_TEXT_CORRECTION_ENABLE_THINKING=false
# qwen 系模型的思考强度（网关仅支持 xhigh/medium/low，qwen3.8 默认 xhigh；deepseek 模型忽略此项）
WRITER_TEXT_CORRECTION_REASONING_EFFORT=low
WRITER_TEXT_CORRECTION_HEARTBEAT_MS=10000
