"object\",\n      \"properties\": {\n        \"limit\": {\n          \"type\": \"integer\",\n          \"description\": \"返回的反馈和评论条数，默认5\",\n          \"default\": 5\n        }\n      }\n    }\n  },\n  {\n    \"name\": \"sendMessage\",\n    \"description\": \"向用户发送最终消息。若证据不足，要明确说明不确定。\",\n    \"parameters\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"message\": {\n          \"type\": \"string\",\n          \"description\": \"发送给用户的消息内容\"\n        }\n      },\n      \"required\": [\n        \"message\"\n      ]\n    }\n  }\n]"
