HOST=127.0.0.1
PORT=8787
BASE_PATH=/log-defence
LOGHOME_API_URL=https://api.loghome.ink
DATA_DIR=/var/lib/loghome-log-defence/players
# null supports the Android app's local file:// container.
ALLOWED_PARENT_ORIGINS=null,https://m.loghome.ink,https://loghome.ink
ALLOW_DEV_TOOLS=0

# Only enable behind a trusted proxy that overwrites X-Real-IP.
TRUST_PROXY=1
