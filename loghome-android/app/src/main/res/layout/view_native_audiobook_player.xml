<?xml version="1.0" ?>
<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@drawable/audiobook_player_background"
        android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
        android:id="@+id/collapseButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:minWidth="0dp"
        android:paddingHorizontal="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:icon="@drawable/audiobook_collapse"
        app:iconTint="#FFFFFF"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:cornerRadius="14dp"
        app:backgroundTint="@android:color/transparent"
        android:contentDescription="收起听书播放器"/>
            <TextView
        android:id="@+id/bookTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:layout_marginEnd="48dp"
        android:text="听书"
        android:textSize="16sp"
        android:textColor="#DCD5E9"
        android:maxLines="1"
        android:ellipsize="end"/>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView
        android:id="@+id/coverCard"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="#382C50">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <ImageView
        android:id="@+id/coverImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="听书封面"
        android:src="@mipmap/ic_launcher"/>
                <View
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_gravity="bottom"
        android:background="@drawable/audiobook_cover_scrim"/>
                <TextView
        android:id="@+id/chapterTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="18dp"
        android:gravity="center"
        android:text="正在准备章节…"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:maxLines="2"
        android:ellipsize="end"/>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
        android:id="@+id/paragraphText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:minLines="2"
        android:maxLines="3"
        android:ellipsize="end"
        android:lineSpacingExtra="5dp"
        android:text="正在加载听书内容…"
        android:textColor="#F2EEF8"
        android:textSize="17sp"/>
        <LinearLayout
        android:id="@+id/modelDownloadContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">
            <TextView
        android:id="@+id/modelDownloadStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="正在下载离线语音…"
        android:textSize="13sp"
        android:textColor="#F2EEF8"/>
            <TextView
        android:id="@+id/modelDownloadProgressText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textSize="12sp"
        android:textColor="#DCD5E9"/>
            <ProgressBar
        android:id="@+id/modelDownloadProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="1000"
        android:progressBackgroundTint="#665778"
        android:progressTint="#FFFFFF"/>
        </LinearLayout>
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
        android:id="@+id/sleepTimerButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingHorizontal="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="定时"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:icon="@drawable/audiobook_clock"
        app:iconTint="#FFFFFF"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:cornerRadius="14dp"
        app:backgroundTint="@android:color/transparent"/>
            <com.google.android.material.button.MaterialButton
        android:id="@+id/speedButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingHorizontal="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="语速 1.0×"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:icon="@drawable/audiobook_speed"
        app:iconTint="#FFFFFF"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:cornerRadius="14dp"
        app:backgroundTint="@android:color/transparent"/>
        </LinearLayout>
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical">
            <TextView
        android:id="@+id/elapsedTime"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:text="0:00"
        android:textSize="13sp"
        android:textColor="#DCD5E9"/>
            <SeekBar
        android:id="@+id/progressSeekBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:max="1000"
        android:progressTint="#FFFFFF"
        android:progressBackgroundTint="#8E819F"
        android:thumbTint="#FFFFFF"/>
            <TextView
        android:id="@+id/durationTime"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="0:00"
        android:textSize="13sp"
        android:textColor="#DCD5E9"/>
        </LinearLayout>
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
        android:id="@+id/rewindButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingHorizontal="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="15"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:icon="@drawable/audiobook_rewind"
        app:iconTint="#FFFFFF"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:cornerRadius="14dp"
        app:backgroundTint="@android:color/transparent"
        android:contentDescription="后退15秒"/>
            <com.google.android.material.button.MaterialButton
        android:id="@+id/previousButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingHorizontal="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:icon="@drawable/audiobook_previous"
        app:iconTint="#FFFFFF"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:cornerRadius="14dp"
        app:backgroundTint="@android:color/transparent"
        android:contentDescription="上一段"
        app:iconPadding="0dp"/>
            <com.google.android.material.button.MaterialButton
        android:id="@+id/playPauseButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingHorizontal="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:icon="@drawable/audiobook_play"
        app:iconTint="#FFFFFF"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:cornerRadius="14dp"
        app:backgroundTint="@android:color/transparent"
        android:contentDescription="播放"
        app:iconPadding="0dp"/>
            <com.google.android.material.button.MaterialButton
        android:id="@+id/nextButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingHorizontal="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:icon="@drawable/audiobook_next"
        app:iconTint="#FFFFFF"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:cornerRadius="14dp"
        app:backgroundTint="@android:color/transparent"
        android:contentDescription="下一段"
        app:iconPadding="0dp"/>
            <com.google.android.material.button.MaterialButton
        android:id="@+id/forwardButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingHorizontal="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="15"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:icon="@drawable/audiobook_forward"
        app:iconTint="#FFFFFF"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:cornerRadius="14dp"
        app:backgroundTint="@android:color/transparent"
        android:contentDescription="前进15秒"/>
        </LinearLayout>
        <ProgressBar
        android:id="@+id/bufferingIndicator"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FFFFFF"
        android:visibility="gone"/>
        <Space android:layout_width="1dp" android:layout_height="20dp" android:layout_weight="1"/>
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
        android:id="@+id/voiceButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1.5"
        android:minWidth="0dp"
        android:paddingHorizontal="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="音色"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:icon="@drawable/audiobook_voice"
        app:iconTint="#FFFFFF"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:cornerRadius="14dp"
        app:backgroundTint="#26FFFFFF"
        android:layout_marginEnd="12dp"/>
            <com.google.android.material.button.MaterialButton
        android:id="@+id/readButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingHorizontal="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="边听边看"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:icon="@drawable/audiobook_read"
        app:iconTint="#FFFFFF"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:cornerRadius="14dp"
        app:backgroundTint="#26FFFFFF"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
