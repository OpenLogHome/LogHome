[{"novel_id":682,"name":"香蕉","content":"在名为【新的世界】的存档里，过去，一座黑色的高塔撑起了下界维度，从此，整个下界发生了翻天覆地的变化。\n而如今，四个来自灵魂沙峡谷的怪物将随着旅程而逐渐揭开这个维度的秘密……\n\n是个人世界观中的下界篇\n中长篇漫画（分五章）（红日篇→金城篇→青林篇→黑塔篇→白星篇）。\n非原作世界观，有较大魔改，方块人画风。","author_id":566,"picUrl":"http://storage.codesocean.top/image/179125800519603","clicks":17,"deleted":0,"create_time":"2026-10-06T03:30:37.000Z","update_time":"2026-10-06T04:10:37.000Z","is_personal":0,"is_complete":0,"text_count":3,"ranking":0,"rank_last":0,"power_base":0,"novel_type":"manga","author_name":"肘击侠","auther_avatar":"http://storage.codesocean.top/image/179117964749963","is_haycraft":0}]